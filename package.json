    "./dialog": "./dist/dialog.mjs",
    "./dialog.browser.js": "./dist/dialog.browser.js",
    "./tooltip": "./dist/tooltip.mjs",
    "./tooltip.browser.js": "./dist/tooltip.browser.js",
    "./menu": "./dist/menu.mjs",
    "./menu.browser.js": "./dist/menu.browser.js",
