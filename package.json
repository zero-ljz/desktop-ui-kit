    "./select": "./dist/select.mjs",
    "./select.browser.js": "./dist/select.browser.js",
    "./pivot": "./dist/pivot.mjs",
    "./pivot.browser.js": "./dist/pivot.browser.js",
    "./sidebar": "./dist/sidebar.mjs",
