  "description": "Scoped, framework-independent styles for desktop settings forms.",
  "private": true,
  "style": "./dist/settings.css",
  "exports": {
    "./settings.css": "./dist/settings.css",
    "./inputs": "./dist/inputs.mjs",
    "./inputs.browser.js": "./dist/inputs.browser.js",
    "./select": "./dist/select.mjs",
    "./select.browser.js": "./dist/select.browser.js",
    "./dialog": "./dist/dialog.mjs",
    "./dialog.browser.js": "./dist/dialog.browser.js",
    "./tooltip": "./dist/tooltip.mjs",
    "./tooltip.browser.js": "./dist/tooltip.browser.js",
    "./menu": "./dist/menu.mjs",
    "./menu.browser.js": "./dist/menu.browser.js",
    "./info-bar": "./dist/info-bar.mjs",
    "./info-bar.browser.js": "./dist/info-bar.browser.js"
